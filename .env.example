# Address of your ComfyUI instance (the one you open in the browser)
COMFY_URL=http://127.0.0.1:8188

# Where comfyvault listens. Keep loopback unless you set an API key.
COMFYVAULT_LISTEN=127.0.0.1:8080

# JSON store: workflows, blocks, presets, runs and downloaded outputs
COMFYVAULT_DATA=./data

# If set, every /api request needs "Authorization: Bearer <key>"
COMFYVAULT_API_KEY=

# How often a run polls ComfyUI for its result, and when it gives up
COMFYVAULT_POLL_INTERVAL=1s
COMFYVAULT_RUN_TIMEOUT=30m
